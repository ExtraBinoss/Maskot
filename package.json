{
  "name": "maskot",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "bun run generate:eye-fit && tsc --noEmit && vite build && vite build --ssr src/entry-server.tsx --outDir artifacts/ssr --emptyOutDir && bun run prerender",
    "prerender": "bun scripts/prerender.ts",
    "bench:engine": "bun scripts/benchmark-engine.ts",
    "generate:eye-fit": "bun scripts/generate-eye-fit.ts",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "bun run lint:oxlint && bun run lint:react",
    "check": "bun run typecheck && bun run lint && bun run format:check && bun run test && bun run build",
    "format": "oxfmt .",
    "test": "vitest run",
    "test:browser": "playwright test",
    "deploy": "wrangler deploy",
    "lint:oxlint": "oxlint .",
    "lint:react": "eslint . --max-warnings 0",
    "format:check": "oxfmt --check .",
    "deploy:check": "wrangler deploy --dry-run"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/source-sans-3": "^5.3.1",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "i18next": "^26.4.7",
    "jotai": "^2.15.0",
    "lucide-react": "^1.58.0",
    "mediabunny": "^1.61.6",
    "motion": "^14.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-i18next": "^17.0.21",
    "shadcn": "^4.22.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^9.39.0",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^30.1.1",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.56.0",
    "vite": "8.3.4",
    "vitest": "^5.0.2",
    "wrangler": "4.151.1"
  }
}
